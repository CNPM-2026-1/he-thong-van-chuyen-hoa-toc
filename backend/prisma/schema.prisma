// Schema Sprint 1: tài khoản + danh mục, theo hợp đồng chung (docs/api-contract.md, docs/openapi.yaml).
// Sẽ đối chiếu với ERD đầy đủ của Đầu mục 3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  DRIVER
  MANAGER
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
  INACTIVE
}

enum StationType {
  BUS_STATION
  WAREHOUSE
  OFFICE
}

enum VehicleType {
  VAN
  TRUCK
  BUS
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String     @map("full_name")
  email        String?    @unique
  phone        String     @unique
  passwordHash String     @map("password_hash")
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  driver        Driver?

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @db.Uuid // = jti trong refresh token
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Station {
  id        String      @id @default(uuid()) @db.Uuid
  code      String      @unique
  name      String
  type      StationType
  address   String
  province  String
  latitude  Float?
  longitude Float?
  phone     String?
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz(3)

  originRoutes      Route[] @relation("RouteOrigin")
  destinationRoutes Route[] @relation("RouteDestination")

  @@index([province])
  @@map("stations")
}

model Route {
  id                       String    @id @default(uuid()) @db.Uuid
  code                     String    @unique
  name                     String
  originStationId          String    @map("origin_station_id") @db.Uuid
  destinationStationId     String    @map("destination_station_id") @db.Uuid
  distanceKm               Float     @default(0) @map("distance_km")
  estimatedDurationMinutes Int       @default(60) @map("estimated_duration_minutes")
  isActive                 Boolean   @default(true) @map("is_active")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(3)

  originStation      Station     @relation("RouteOrigin", fields: [originStationId], references: [id])
  destinationStation Station     @relation("RouteDestination", fields: [destinationStationId], references: [id])
  priceRules         PriceRule[]

  @@index([originStationId])
  @@index([destinationStationId])
  @@map("routes")
}

model Vehicle {
  id               String        @id @default(uuid()) @db.Uuid
  plateNumber      String        @unique @map("plate_number")
  vehicleType      VehicleType   @map("vehicle_type")
  capacityKg       Float         @map("capacity_kg")
  capacityVolumeM3 Float?        @map("capacity_volume_m3")
  status           VehicleStatus @default(AVAILABLE)
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(3)

  drivers Driver[]

  @@map("vehicles")
}

model Driver {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  licenseNumber    String    @unique @map("license_number")
  defaultVehicleId String?   @map("default_vehicle_id") @db.Uuid
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  user           User     @relation(fields: [userId], references: [id])
  defaultVehicle Vehicle? @relation(fields: [defaultVehicleId], references: [id])

  @@map("drivers")
}

model PriceRule {
  id                String    @id @default(uuid()) @db.Uuid
  routeId           String    @map("route_id") @db.Uuid
  baseFeeVnd        Int       @map("base_fee_vnd")
  pricePerKgVnd     Int       @map("price_per_kg_vnd")
  expressMultiplier Float     @default(1) @map("express_multiplier")
  codFeeVnd         Int       @default(0) @map("cod_fee_vnd")
  effectiveFrom     DateTime  @map("effective_from") @db.Timestamptz(3)
  effectiveTo       DateTime? @map("effective_to") @db.Timestamptz(3)
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  route Route @relation(fields: [routeId], references: [id])

  @@index([routeId, effectiveFrom])
  @@map("price_rules")
}
