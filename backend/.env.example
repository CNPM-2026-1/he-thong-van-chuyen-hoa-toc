# Sao chép thành .env rồi chỉnh theo máy của bạn
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hoatoc?schema=public"

# Đổi thành chuỗi ngẫu nhiên dài khi deploy
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Danh sách origin được gọi API, cách nhau bởi dấu phẩy ("*" = tất cả)
CORS_ORIGINS=*
