# Sao chép thành .env rồi chỉnh theo máy của bạn
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hoatoc?schema=public"

# Đổi thành chuỗi ngẫu nhiên dài khi deploy
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Danh sách origin được gọi API, cách nhau bởi dấu phẩy ("*" = tất cả)
CORS_ORIGINS=*

# OTP: local development prints the OTP to backend logs; production requires an SMS provider.
OTP_ENCRYPTION_KEY=change-me-otp-encryption-key
OTP_HASH_SECRET=change-me-otp-hash-secret
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_SENDER=HoaToc

# S3-compatible object storage (MinIO/AWS S3) for delivery and incident evidence.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hoatoc-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
